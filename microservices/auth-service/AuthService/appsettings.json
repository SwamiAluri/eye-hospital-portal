{
  "ConnectionStrings": {
    "DefaultConnection": "Host=hospitalportal-db-server.postgres.database.azure.com;Port=5432;Database=hospitalportal;Username=postgres;Password=NewPass@2026!;SSL Mode=Require;Trust Server Certificate=true;Timeout=30;Command Timeout=30;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Keepalive=30;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InternalApi": {
    "Key": "hp-internal-svc-key-change-in-production-2026"
  },
  "IpManagementService": {
    "BaseUrl": "http://localhost:5074/api"
  },
  "CcmsService": {
    "BaseUrl": "http://localhost:7075/api"
  },
  "Jwt": {
    "Key": "your-secret-key-min-32-characters-change-this",
    "Secret": "your-secret-key-min-32-characters-change-this",
    "Issuer": "EyeHospitalAuth",
    "Audience": "EyeHospitalAPI",
    "ExpiryInMinutes": 60,
    "ExpireMinutes": 60
  },
  "PasswordPolicy": {
    "MinimumLength": 12,
    "DaysToExpire": 90,
    "InitialExpiryHours": 24,
    "FailedLoginLockoutMinutes": 15,
    "MaxFailedLoginAttempts": 5
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/auth-service-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "RateLimiting": {
    "GlobalLimits": {
      "PermitLimit": 100,
      "Window": "00:01:00",
      "QueueLimit": 2
    },
    "EndpointLimits": {
      "Auth": {
        "Login": {
          "PermitLimit": 5,
          "Window": "00:05:00",
          "QueueLimit": 0
        },
        "Register": {
          "PermitLimit": 2,
          "Window": "00:10:00",
          "QueueLimit": 0
        }
      }
    }
  },
  "NotificationService": {
    "BaseUrl": "http://localhost:7072",
    "UseMockService": false
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "your-email@example.com",
    "SmtpPassword": "your-app-password",
    "FromAddress": "noreply@hospitalsystem.com",
    "FromName": "Hospital Portal"
  },
  "Twilio": {
    "AccountSid": "your-twilio-account-sid",
    "AuthToken": "your-twilio-auth-token",
    "FromNumber": "+1234567890"
  },
  "AzureBlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "PatientPhotosContainer": "patient-media",
    "MaxFileSizeMB": 10,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/jpg",
      "image/png",
      "image/webp"
    ]
  },
  "AzureSpeech": {
    "Key": "YOUR_AZURE_SPEECH_KEY",
    "Region": "eastus",
    "Endpoint": "https://eastus.api.cognitive.microsoft.com/speechtotext/v3.0/",
    "SupportedLanguages": [
      "en-US",
      "hi-IN",
      "te-IN"
    ]
  },
  "AzureTranslator": {
    "Key": "YOUR_AZURE_TRANSLATOR_KEY",
    "Region": "eastus",
    "Endpoint": "https://api.cognitive.microsofttranslator.com"
  },
  "FeatureFlags": {
    "MasterData": {
      "Enabled": true,
      "EnabledGroups": {
        "PatientSetup": true,
        "Clinical": true,
        "Appointments": true,
        "Counsellor": true,
        "BillingFinance": true,
        "Insurance": true,
        "Inventory": true,
        "Pharmacy": true,
        "LabDiagnostics": true,
        "WardIp": true,
        "HrStaff": true,
        "System": true,
        "Operations": true
      }
    }
  }
}
