    "test:e2e": "playwright test",
    "test:e2e:optometry": "npx playwright test e2e/optometry-as-ps.spec.ts --project=chromium",
    "test:e2e:master-data": "npx playwright test e2e/master-data-used-by.spec.ts e2e/master-data-edit-refresh.spec.ts --project=chromium",
    "test:e2e:counselling": "npx playwright test e2e/counselling-session.spec.ts e2e/counselling-packages-admin.spec.ts --project=chromium",
    "test:e2e:patient-hub": "npx playwright test e2e/patient-hub.spec.ts --project=chromium-hub",
    "test:e2e:ward-preop": "npx playwright test e2e/ip-ward-preop-workspace.spec.ts --project=chromium-ward-preop --workers=1",
    "test:e2e:ward-journey": "npx playwright test e2e/ip-ward-preop-workspace.spec.ts e2e/ip-checklist-closure.spec.ts e2e/ip-checklist-rbac.spec.ts e2e/ip-ward-cancel-today.spec.ts e2e/ip-ot-journey.spec.ts e2e/ip-ward-rebook.spec.ts e2e/ip-ward-phase3.spec.ts e2e/ip-ward-program-closure.spec.ts e2e/ip-ward-scheduling-guard.spec.ts --project=chromium-ward-journey --workers=1",
    "test:e2e:ip-checklist": "npx playwright test e2e/ip-checklist-closure.spec.ts e2e/ip-checklist-rbac.spec.ts --project=chromium-ward-preop --workers=1",
    "resolve:e2e:ward": "npx tsx scripts/resolve-e2e-ward-fixtures.ts",
    "resolve:e2e:counselling": "npx tsx scripts/resolve-e2e-counselling-fixtures.ts",
    "import:legacy-lab-catalog": "npx tsx scripts/run-import-legacy-lab-catalog.ts",
    "link:counselling-packages": "npx tsx scripts/run-link-counselling-package-catalog.ts",
    "seed:f23-master": "npx tsx scripts/seed-f23-master-entity-types.ts",
    "seed:medical-history": "npx tsx scripts/seed-medical-history-registry.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
